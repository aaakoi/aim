{
  "dashboard": {
    "title": "AIM Server Dashboard",
    "uid": "aim-server",
    "panels": [
      {
        "title": "在线用户数",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "aim_online_users",
            "legendFormat": "在线用户"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "unit": "none"
          }
        }
      },
      {
        "title": "消息吞吐量 (每秒)",
        "type": "timeseries",
        "gridPos": {"x": 8, "y": 0, "w": 16, "h": 6},
        "targets": [
          {
            "expr": "rate(aim_messages_total[1m])",
            "legendFormat": "{{type}}"
          }
        ]
      },
      {
        "title": "Bot 响应延迟",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 6, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(aim_bot_latency_seconds_bucket[5m]))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(aim_bot_latency_seconds_bucket[5m]))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(aim_bot_latency_seconds_bucket[5m]))",
            "legendFormat": "P99"
          }
        ]
      },
      {
        "title": "WebSocket 连接统计",
        "type": "stat",
        "gridPos": {"x": 12, "y": 6, "w": 6, "h": 3},
        "targets": [
          {
            "expr": "aim_ws_connections_total",
            "legendFormat": "总连接"
          }
        ]
      },
      {
        "title": "WebSocket 断开数",
        "type": "stat",
        "gridPos": {"x": 18, "y": 6, "w": 6, "h": 3},
        "targets": [
          {
            "expr": "aim_ws_disconnections_total",
            "legendFormat": "总断开"
          }
        ]
      },
      {
        "title": "HTTP 请求 QPS",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "rate(aim_http_requests_total[1m])",
            "legendFormat": "{{endpoint}} - {{method}}"
          }
        ]
      },
      {
        "title": "Bot Token 使用量",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 12, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "rate(aim_bot_tokens_total[5m])",
            "legendFormat": "{{type}} - {{provider}}"
          }
        ]
      },
      {
        "title": "Bot 请求成功率",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 18, "w": 8, "h": 4},
        "targets": [
          {
            "expr": "sum(rate(aim_bot_requests_total{status=\"success\"}[5m])) / sum(rate(aim_bot_requests_total[5m])) * 100",
            "legendFormat": "成功率 %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "unit": "percent"
          }
        }
      }
    ]
  }
}
